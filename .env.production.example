NODE_ENV=production
PORT=3000
POSTGRES_DB=ai_healthcare
POSTGRES_USER=ai_healthcare
POSTGRES_PASSWORD=replace-with-a-strong-database-secret
REDIS_PASSWORD=replace-with-a-distinct-high-entropy-redis-secret
REDIS_DB=0
VOICE_SESSION_TTL_SECONDS=1800
CORS_ORIGIN=https://app.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
VOICE_GATEWAY_API_KEY=replace-with-a-dedicated-high-entropy-machine-secret
ELEVENLABS_API_KEY=replace-with-the-provider-secret
ELEVENLABS_AGENT_ID=replace-with-the-agent-id
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_VOICE_WIDGET_KEY=wgt_replace_with_public_widget_key
