generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantRole {
  CLINIC_OWNER
  CLINIC_ADMIN
  RECEPTIONIST
}

enum DateFormat {
  MM_DD_YYYY
  DD_MM_YYYY
  YYYY_MM_DD
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConfigurationStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum PreferredContactMethod {
  PHONE
  EMAIL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique
  passwordHash      String
  firstName         String
  lastName          String
  platformRole      PlatformRole?
  status            UserStatus           @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authSessions      AuthSession[]
  passwordResets    PasswordResetToken[]
  tenantMemberships TenantMembership[]
}

model Tenant {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      TenantStatus       @default(ACTIVE)
  dateFormat  DateFormat         @default(MM_DD_YYYY)
  timezone    String             @default("UTC")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  locations   Location[]
  providers   Provider[]
  services    Service[]
  patients    Patient[]

  @@index([status])
  @@index([name])
}

model Patient {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  firstName              String
  normalizedFirstName    String
  middleName             String?
  lastName               String
  normalizedLastName     String
  dateOfBirth            DateTime                @db.Date
  phone                  String
  email                  String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  stateProvince          String?
  postalCode             String?
  countryCode            String?                 @db.Char(2)
  preferredContactMethod PreferredContactMethod?
  status                 PatientStatus           @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, normalizedLastName, normalizedFirstName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, dateOfBirth])
}

model Location {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  name                  String
  normalizedName        String
  status                ConfigurationStatus @default(ACTIVE)
  phone                 String
  email                 String?
  timezone              String
  addressLine1          String
  addressLine2          String?
  city                  String
  stateProvince         String
  postalCode            String
  countryCode           String              @db.Char(2)
  escalationPhoneNumber String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessHours         BusinessHour[]
  providerLocations     ProviderLocation[]
  locationServices      LocationService[]

  @@unique([tenantId, normalizedName])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model BusinessHour {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  locationId String    @db.Uuid
  dayOfWeek  DayOfWeek
  isClosed   Boolean
  openTime   String?   @db.VarChar(5)
  closeTime  String?   @db.VarChar(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([tenantId, locationId])
}

model Provider {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  firstName         String
  lastName          String
  displayName       String?
  title             String?
  email             String?
  phone             String?
  status            ConfigurationStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerLocations ProviderLocation[]
  providerServices  ProviderService[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
}

model Service {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  name             String
  normalizedName   String
  description      String?
  durationMinutes  Int
  status           ConfigurationStatus @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerServices ProviderService[]
  locationServices LocationService[]

  @@unique([tenantId, normalizedName])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model ProviderLocation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  providerId String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Cascade)
  location   Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([providerId, locationId])
  @@index([tenantId, providerId])
  @@index([tenantId, locationId])
}

model ProviderService {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  providerId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Cascade)
  service    Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([tenantId, providerId])
  @@index([tenantId, serviceId])
}

model LocationService {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  locationId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  service    Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([locationId, serviceId])
  @@index([tenantId, locationId])
  @@index([tenantId, serviceId])
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, role, status])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
