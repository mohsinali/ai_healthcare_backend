generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantRole {
  CLINIC_OWNER
  CLINIC_ADMIN
  RECEPTIONIST
}

enum DateFormat {
  MM_DD_YYYY
  DD_MM_YYYY
  YYYY_MM_DD
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConfigurationStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum PreferredContactMethod {
  PHONE
  EMAIL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SequenceType {
  APPOINTMENT
  LOCATION
  SERVICE
  PROVIDER
  PATIENT
  FAQ
}

enum FAQCategory {
  GENERAL
  HOURS
  LOCATION
  PARKING
  APPOINTMENTS
  INSURANCE
  PAYMENTS
  SERVICES
  PREPARATION
  POLICIES
  ACCESSIBILITY
  OTHER
}

enum FAQStatus {
  ACTIVE
  INACTIVE
}

enum TelephonyProvider {
  TWILIO
}

enum TelephonyNumberStatus {
  ACTIVE
  INACTIVE
}

enum WebVoiceChannelStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique
  passwordHash          String
  firstName             String
  lastName              String
  platformRole          PlatformRole?
  status                UserStatus           @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authSessions          AuthSession[]
  passwordResets        PasswordResetToken[]
  tenantMemberships     TenantMembership[]
  createdAppointments   Appointment[]        @relation("AppointmentCreatedBy")
  cancelledAppointments Appointment[]        @relation("AppointmentCancelledBy")
  appointmentEvents     AppointmentEvent[]
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  status            TenantStatus       @default(ACTIVE)
  dateFormat        DateFormat         @default(MM_DD_YYYY)
  timezone          String             @default("UTC")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       TenantMembership[]
  locations         Location[]
  providers         Provider[]
  services          Service[]
  patients          Patient[]
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]
  sequences         Sequence[]
  faqs              FAQ[]
  telephonyNumbers  TelephonyNumber[]
  webVoiceChannels  WebVoiceChannel[]

  @@index([status])
  @@index([name])
}

model Patient {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  patientNumber          String
  firstName              String
  normalizedFirstName    String
  middleName             String?
  lastName               String
  normalizedLastName     String
  dateOfBirth            DateTime                @db.Date
  phone                  String
  email                  String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  stateProvince          String?
  postalCode             String?
  countryCode            String?                 @db.Char(2)
  preferredContactMethod PreferredContactMethod?
  status                 PatientStatus           @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments           Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, patientNumber])
  @@index([tenantId, status])
  @@index([tenantId, normalizedLastName, normalizedFirstName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, dateOfBirth])
}

model Location {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  locationNumber        String
  name                  String
  normalizedName        String
  status                ConfigurationStatus @default(ACTIVE)
  phone                 String
  email                 String?
  timezone              String
  addressLine1          String
  addressLine2          String?
  city                  String
  stateProvince         String
  postalCode            String
  countryCode           String              @db.Char(2)
  escalationPhoneNumber String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessHours         BusinessHour[]
  providerLocations     ProviderLocation[]
  locationServices      LocationService[]
  appointments          Appointment[]
  faqs                  FAQ[]
  telephonyNumbers      TelephonyNumber[]
  webVoiceChannels      WebVoiceChannel[]

  @@unique([tenantId, normalizedName])
  @@unique([tenantId, id])
  @@unique([tenantId, locationNumber])
  @@index([tenantId, status])
}

model TelephonyNumber {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  locationId            String?               @db.Uuid
  phoneNumber           String                @unique
  provider              TelephonyProvider
  providerPhoneNumberId String?
  status                TelephonyNumberStatus @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location              Location?             @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([provider, providerPhoneNumberId])
}

model WebVoiceChannel {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  locationId      String?               @db.Uuid
  publicWidgetKey String                @unique
  agentId         String?
  status          WebVoiceChannelStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        Location?             @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
}

model BusinessHour {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  locationId String    @db.Uuid
  dayOfWeek  DayOfWeek
  isClosed   Boolean
  openTime   String?   @db.VarChar(5)
  closeTime  String?   @db.VarChar(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([tenantId, locationId])
}

model Provider {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  providerNumber    String
  firstName         String
  lastName          String
  displayName       String?
  title             String?
  email             String?
  phone             String?
  status            ConfigurationStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerLocations ProviderLocation[]
  providerServices  ProviderService[]
  appointments      Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, providerNumber])
  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
}

model Service {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  serviceNumber    String
  name             String
  normalizedName   String
  description      String?
  durationMinutes  Int
  status           ConfigurationStatus @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  providerServices ProviderService[]
  locationServices LocationService[]
  appointments     Appointment[]

  @@unique([tenantId, normalizedName])
  @@unique([tenantId, id])
  @@unique([tenantId, serviceNumber])
  @@index([tenantId, status])
}

model ProviderLocation {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  providerId             String                  @db.Uuid
  locationId             String                  @db.Uuid
  createdAt              DateTime                @default(now())
  provider               Provider                @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Cascade)
  location               Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  providerWorkingPeriods ProviderWorkingPeriod[]

  @@unique([providerId, locationId])
  @@unique([tenantId, providerId, locationId], map: "pl_tenant_provider_location_key")
  @@index([tenantId, providerId])
  @@index([tenantId, locationId])
}

model ProviderWorkingPeriod {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  providerId       String           @db.Uuid
  locationId       String           @db.Uuid
  dayOfWeek        DayOfWeek
  startTime        String           @db.VarChar(5)
  endTime          String           @db.VarChar(5)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  providerLocation ProviderLocation @relation(fields: [tenantId, providerId, locationId], references: [tenantId, providerId, locationId], onDelete: Cascade, map: "pwp_provider_location_fkey")

  @@unique([tenantId, id], map: "pwp_tenant_id_key")
  @@unique([tenantId, providerId, locationId, dayOfWeek, startTime, endTime], map: "pwp_exact_period_key")
  @@index([tenantId, providerId, locationId, dayOfWeek, isActive], map: "pwp_provider_schedule_idx")
  @@index([tenantId, locationId, dayOfWeek, isActive], map: "pwp_location_schedule_idx")
}

model ProviderService {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  providerId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Cascade)
  service    Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([tenantId, providerId])
  @@index([tenantId, serviceId])
}

model LocationService {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  locationId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  service    Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([locationId, serviceId])
  @@index([tenantId, locationId])
  @@index([tenantId, serviceId])
}

model Sequence {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  type      SequenceType
  prefix    String
  nextValue Int          @default(1)
  padding   Int          @default(2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model FAQ {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  faqNumber         String
  locationId        String?     @db.Uuid
  category          FAQCategory
  question          String      @db.VarChar(500)
  answer            String      @db.VarChar(8000)
  keywords          String[]    @default([])
  keywordSearchText String      @default("") @db.VarChar(2019)
  status            FAQStatus   @default(ACTIVE)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location          Location?   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, faqNumber])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, locationId])
  @@index([tenantId, updatedAt, id])
}

model Appointment {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  appointmentNumber  String
  patientId          String             @db.Uuid
  locationId         String             @db.Uuid
  providerId         String             @db.Uuid
  serviceId          String             @db.Uuid
  startAt            DateTime           @db.Timestamptz(3)
  endAt              DateTime           @db.Timestamptz(3)
  status             AppointmentStatus  @default(BOOKED)
  reason             String?            @db.VarChar(500)
  notes              String?            @db.VarChar(2000)
  createdByUserId    String?            @db.Uuid
  cancelledAt        DateTime?          @db.Timestamptz(3)
  cancelledByUserId  String?            @db.Uuid
  cancellationReason String?            @db.VarChar(500)
  confirmedAt        DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient            Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  location           Location           @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  provider           Provider           @relation(fields: [tenantId, providerId], references: [tenantId, id], onDelete: Restrict)
  service            Service            @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  createdBy          User?              @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy        User?              @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  events             AppointmentEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentNumber])
  @@index([tenantId, startAt, id])
  @@index([tenantId, patientId, startAt])
  @@index([tenantId, providerId, startAt])
  @@index([tenantId, locationId, startAt])
  @@index([tenantId, status, startAt])
}

model AppointmentEvent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  appointmentId String               @db.Uuid
  type          AppointmentEventType
  actorUserId   String?              @db.Uuid
  occurredAt    DateTime             @default(now()) @db.Timestamptz(3)
  metadata      Json?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment   Appointment          @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  actorUser     User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, appointmentId, occurredAt])
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, role, status])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
